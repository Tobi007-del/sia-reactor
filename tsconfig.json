{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "preserveSymlinks": true,
    "types": ["node"],
    "jsx": "react-jsx",
    "outDir": "./dist",
    "rootDir": "./",
    "paths": {
      "@src/*": ["./src/*"],
      "@core/*": ["./src/ts/core/*"],
      "@defs/*": ["./src/ts/types/*"],
      "@adapters/*": ["./src/ts/adapters/*"],
      "@modules/*": ["./src/ts/modules/*"],
      "@utils/*": ["./src/ts/utils/*"],
      "@styles/*": ["./src/css/*"]
    }
  },
  "include": ["src/**/*", "tests", "tsup.config.ts"]
}
